{
  "schema": 1,
  "permissions": ["storage.read", "storage.write", "tools.invoke", "llm.complete"],
  "required_executas": [
    {
      "tool_id": "bundled:mini-notes",
      "min_version": "0.1.0"
    }
  ],
  "ui": {
    "bundle": { "format": "static-spa", "entry": "index.html" },
    "views": [
      {
        "name": "main",
        "title": "Mini Notes",
        "default": true,
        "min_size": { "w": 360, "h": 460 },
        "default_size": { "w": 480, "h": 640 }
      }
    ],
    "host_api": {
      "storage": ["get", "set"],
      "llm": ["complete"],
      "tools": ["required:*"]
    }
  }
}
